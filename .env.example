# ================================
# ADW Configuration
# ================================

# Claude Code CLI path (default: "claude")
# If 'claude' doesn't work, run 'which claude' and paste the result here
CLAUDE_CODE_PATH=claude

# ================================
# Claude Authentication
# ================================

# Run: claude login
# ADW uses OAuth tokens from ~/.claude/.credentials.json
# Works with Claude Max subscription - no API key needed

# ================================
# GitHub Configuration
# ================================

# GitHub PAT (optional - uses `gh auth` by default)
# Use this if you want ADW to use a different GitHub account than your default 'gh auth' login
# GITHUB_PAT=ghp_your_token_here

# ================================
# Optional: Cloudflare R2 Upload (for review screenshots)
# ================================

# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_BUCKET_NAME=
# CLOUDFLARE_R2_PUBLIC_DOMAIN=

# ================================
# Webhook Server Configuration
# ================================

# Webhook server port (default: 8001)
PORT=8001

# Cloudflare tunnel token (optional, for exposing webhook to GitHub)
# CLOUDFLARED_TUNNEL_TOKEN=

# Multi-repo base directory (for multi-repo webhook support)
# REPOS_BASE_DIR=/path/to/repos

# ================================
# Execution Settings
# ================================

# Keep working directory during bash execution (default: true)
CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR=true

# Agent sandbox (optional)
# E2B_API_KEY=
